{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tempo",
  "mainBinaryName": "tempo",
  "version": "0.1.0",
  "identifier": "fr.tempo.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../frontend" }
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Productivity",
    "shortDescription": "Notes, tâches et rapports assistés par LLM",
    "resources": ["resources/**/*"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["French"] },
      "wix": { "language": "fr-FR" }
    }
  }
}
