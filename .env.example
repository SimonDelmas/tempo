# Configuration de Tempo. Emplacements lus, dans l'ordre : TEMPO_ENV_FILE, dossier courant,
# racine du dépôt (développement), puis %APPDATA%\Tempo\.env (application installée).

# Dossier des notes (vault). Par défaut : ./vault-exemple en développement, Documents\Tempo sinon
TEMPO_VAULT=C:/Users/moi/Documents/Notes

# API Vibe (compatible OpenAI)
VIBE_BASE_URL=https://vibe.example.com/v1
VIBE_API_KEY=changeme
# Optionnel : certificat d'autorité (fichier .pem) à la place du magasin de certificats Windows
# VIBE_CA_BUNDLE=C:/certs/company-ca.pem

# Modèles : rapide (analyse) et puissant (rédaction)
TEMPO_MODEL_FAST=gpt-luna
TEMPO_MODEL_SMART=claude-opus

# Recherche sémantique (optionnel) : modèle d'embeddings d'une API compatible OpenAI.
# Sans modèle, la fonctionnalité est désactivée. URL et clé par défaut : celles de Vibe.
# TEMPO_EMBED_MODEL=text-embedding-3-small
# TEMPO_EMBED_BASE_URL=https://api.example.com/v1
# TEMPO_EMBED_API_KEY=changeme
# Sans API d'embeddings, le modèle local livré avec l'application est utilisé (chargé à la
# demande) : le désactiver, ou désigner d'autres fichiers ; seuil de similarité des passages
# retenus par le sens (0,83 pour le modèle local)
# TEMPO_EMBED_LOCAL=off
# TEMPO_EMBED_LOCAL_DIR=C:/outils/models/multilingual-e5-small
# TEMPO_ONNXRUNTIME=C:/outils/onnxruntime.dll
# TEMPO_EMBED_MIN_SIMILARITY=0.83

# Bibliothèque de documents : dossier (par défaut <vault>/bibliotheque), cache de l'index
# (par défaut %LOCALAPPDATA%Tempoche...), outils de conversion (par défaut livrés avec
# l'application, sinon le PATH) et modèle qui propose le classement (TEMPO_MODEL_FAST par défaut)
# TEMPO_LIBRARY=C:/Users/moi/Documents/Notes/bibliotheque
# TEMPO_LIBRARY_CACHE=C:/Users/moi/AppData/Local/Tempo/cache/bibliotheque
# TEMPO_PANDOC=C:/outils/pandoc.exe
# TEMPO_PDFIUM=C:/outils/pdfium.dll
# TEMPO_MODEL_CLASSIFY=gpt-luna

# Raccourcis clavier de navigation entre les vues : modificateurs (Ctrl, Alt, Shift, Meta)
# et touche au format KeyboardEvent.key, séparés par « + »
# TEMPO_SHORTCUT_BACK=Alt+ArrowLeft
# TEMPO_SHORTCUT_FORWARD=Alt+ArrowRight

# Application de bureau : port local (48765 par défaut, un port libre est pris s'il est occupé)
# TEMPO_DESKTOP_PORT=48765

# Serveur seul (tempo-server)
TEMPO_HOST=127.0.0.1
TEMPO_PORT=8765
