# Dossier des notes (vault). Par défaut : ./vault-exemple
TEMPO_VAULT=C:/Users/moi/Documents/Notes

# API Vibe (compatible OpenAI)
VIBE_BASE_URL=https://vibe.example.suez.com/v1
VIBE_API_KEY=changeme
# Optionnel : certificat d'autorité interne (chemin vers un .pem)
# VIBE_CA_BUNDLE=C:/certs/suez-ca.pem

# Modèles : rapide (analyse) et puissant (rédaction)
TEMPO_MODEL_FAST=gpt-luna
TEMPO_MODEL_SMART=claude-opus

# Serveur
TEMPO_HOST=127.0.0.1
TEMPO_PORT=8765
